# Anthropic API key - required for the agent's reasoning loop
ANTHROPIC_API_KEY=

# GitHub personal access token - optional, needed for the project-tracking skill
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=owner/repo

# Google OAuth - optional, needed for the email/calendar skill.
# Create an OAuth client (Desktop app) in Google Cloud Console, enable the
# Gmail API and Calendar API, download the JSON, save it as credentials.json
# in the project root. A token.json will be created automatically on first
# successful login.
